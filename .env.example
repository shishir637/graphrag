# Context Layer runs no AI model and needs no API key.
# Password for the internal database (required for docker compose). Use a long random value.
CL_DB_PASSWORD=
# Key that encrypts stored secrets (connector tokens, database passwords). Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Several keys (newest first, comma separated) allow rotation: add the new one first, restart, then run
#   docker compose exec worker python -m app.vault rotate     and remove the old key.
CL_SECRET_KEY=
# Instead of CL_SECRET_KEY: a file (Docker / Kubernetes secret, one key per line) or a secrets manager:
# CL_SECRET_KEY_FILE=/run/secrets/cl_secret_key
# CL_SECRET_KEY_PROVIDER=aws:context-layer/master-key   (or gcp:..., azure:..., vault:..., module:pkg.mod:fn)
# production: refuse to start without one of the above (instead of generating a key file)
# CL_ENV=production
# Any of CL_DATABASE_URL, CL_DB_PASSWORD, QDRANT_API_KEY and CL_SECRET_KEY can be read from a file: NAME_FILE=/path
# Keep a copy of audit events older than the retention period (one Parquet file per month) before deleting them
# CL_EVENTS_ARCHIVE=1
# Key for the search index (Qdrant); any long random value. The index is never published outside Docker.
CL_QDRANT_API_KEY=
# Behind a reverse proxy: trust X-Forwarded-For for key IP allow-lists (only if the proxy sets it)
# CL_TRUST_PROXY=1
# Who can create a workspace: invite (default: owners add people), open (anyone can sign up) or off
# CL_SIGNUP=invite
# Names this server is reached under, so agents can connect (comma separated), e.g. contextlayer.acme.com
CL_PUBLIC_HOSTS=
# Listen on all interfaces instead of only this machine (put HTTPS in front first)
# CL_BIND=0.0.0.0
# Knowledge graph quality: accurate (GLiNER + spaCy), fast (spaCy only) or ai (optional AI extraction,
# set up in Settings → AI extraction; used only for graph builds, never for answering)
# CL_GRAPH_MODE=accurate
# Re-ranker: BAAI/bge-reranker-v2-m3-int8 (default), jinaai/jina-reranker-v1-turbo-en (faster), or none
# CL_RERANKER=BAAI/bge-reranker-v2-m3-int8
# Publish the MCP endpoint through Cloudflare (see docker-compose.yml). Only /mcp is public; the admin
# web app stays on this computer unless CL_PUBLIC_ADMIN=1.
# CL_PUBLIC_HOSTS=*.trycloudflare.com
# CLOUDFLARE_TUNNEL_TOKEN=
# CL_PUBLIC_URL=https://contextlayer.yourdomain.com

# Sign-in from Claude / ChatGPT (OAuth). On by default: people add the public /mcp link as a connector and
# sign in with their Context Layer account. Set to 0 to accept agent keys only.
# CL_OAUTH=1
