# Put your Claude API key after the = sign. Keep this file private.
ANTHROPIC_API_KEY=
# Only needed for user-level keys (sk-ant-usr-...): Console > Settings > Workspaces, id starts with wrkspc_
ANTHROPIC_WORKSPACE_ID=

# ---- Context Layer app (docker compose) ----
# Password for the internal graph database (required for docker compose). Use a long random value.
CL_DB_PASSWORD=
# Names this server is reached under, so agents can connect (comma separated), e.g. contextlayer.acme.com
CL_PUBLIC_HOSTS=
# Listen on all interfaces instead of only this machine (put HTTPS in front first)
# CL_BIND=0.0.0.0
