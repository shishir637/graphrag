# Put your Claude API key after the = sign. Keep this file private.
ANTHROPIC_API_KEY=
# Only needed for user-level keys (sk-ant-usr-...): Console > Settings > Workspaces, id starts with wrkspc_
ANTHROPIC_WORKSPACE_ID=

# ---- GraphRAG (all optional) ----
# No key? Everything still runs without an LLM (see README "Running without an API key").
# Local model instead of Claude (Ollama):
# GRAPH_LLM=openai
# GRAPH_LLM_MODEL=qwen2.5:7b
# GRAPH_LLM_BASE_URL=http://localhost:11434/v1
# Switch the LLM off even when a key is set:
# GRAPH_LLM=none
# Extraction: hybrid (default) | gliner | llm
# EXTRACT_MODE=hybrid
# Graph storage: age (default, needs Postgres + Apache AGE) | json
# GRAPH_STORE=json
# GRAPH_DSN=postgresql://clp:clp@127.0.0.1:5432/graphrag
